# ============================================================================
# OTB Agency - Production Environment Variables
# ============================================================================

# Network & Server
PORT=8088
HOST=0.0.0.0
NODE_ENV=production

# Storage Engine (local | api)
STORAGE_MODE=local
API_BASE_URL=/api/v1

# Security Passcode
ADMIN_PIN=CHANGE_THIS_IN_PRODUCTION

# Production Domain (Used for CORS & Canonical Links)
CANONICAL_DOMAIN=https://otbagency.com
